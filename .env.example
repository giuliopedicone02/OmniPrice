# =============================================================================
# OmniPrice — esempio di configurazione
# =============================================================================
# Queste proprietà corrispondono a quelle di
# backend/omniprice/src/main/resources/application.properties e possono essere
# sovrascritte da variabili d'ambiente o argomenti da riga di comando, es.:
#
#   ./mvnw spring-boot:run -Dspring-boot.run.arguments=--omniprice.rabbitmq.enabled=true
#
# Copiare/adattare secondo necessità. NON committare segreti reali.

# --- Server ---
SERVER_PORT=8080

# --- Sicurezza / JWT ---
# Chiave di firma JWT codificata in Base64. In produzione generare un segreto
# proprio (es. `openssl rand -base64 64`) e NON riutilizzare quello di sviluppo.
OMNIPRICE_JWT_SECRET=change-me-with-a-base64-secret
OMNIPRICE_JWT_EXPIRATION=86400000

# --- RabbitMQ ---
OMNIPRICE_RABBITMQ_ENABLED=false
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --- Resilience4J (store) ---
OMNIPRICE_STORE_TIMEOUT_SECONDS=3
OMNIPRICE_STORE_RETRY_ATTEMPTS=2
OMNIPRICE_STORE_CB_FAILURE_RATE=50

# --- Rate limiting login (con Exponential Backoff) ---
OMNIPRICE_RATELIMIT_LOGIN_LIMIT_FOR_PERIOD=5
OMNIPRICE_RATELIMIT_LOGIN_REFRESH_PERIOD_SECONDS=30
OMNIPRICE_RATELIMIT_LOGIN_MAX_PENALTY_SECONDS=300

# --- Scheduler ---
OMNIPRICE_SCHEDULER_PRICE_CHECK_CRON=0 */5 * * * *
OMNIPRICE_SCHEDULER_BATCH_WRITE_CRON=0 */2 * * * *

# --- Idempotent Receiver ---
OMNIPRICE_IDEMPOTENCY_RETENTION_MINUTES=60
